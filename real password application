a=input("Enter a password:")
up=0
sw=0
sp=0
dg=0
if len(a)>7:
  for i in a:
    if i.isupper():
      up=up+1
    elif i.islower():
      sw=sw+1
    elif i.isdigit():
      dg=dg+1
    else:
      sp=sp+1
  if up>0 and sw>0 and sp>0 and dg>0:
    print("STRONG")
  else:
    print("WEAK")
else:
  print("WEAK pass due to less no.of characters")
