#prime
def prime(n):
  if n<=1:
    return False
  else:
    for i in range(2,n):
      if n%i==0:
        return False
    return True
#sod
def sod(n):
  d=[int(i) for i in str(n)]
  return sum(d)
#every
def every(n):
  for i in range(3):
    d=n%10
    n=n//10
    if not prime(d):
      return False
  return True
